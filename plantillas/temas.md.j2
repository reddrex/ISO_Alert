{% from "_macros.j2" import estado, enlace, enlaces %}
{% macro norma(f) -%}
<div class="norma{% if f.estado.value in ('sustituida', 'anulada', 'no_publicada') %} norma--historica{% endif %}" id="{{ f.ancla }}">
  <p class="norma__cabecera"><a class="norma__codigo" href="estado/?texto={{ f.codigo | urlencode }}" title="Ver en la tabla de estado">{{ f.codigo }}</a> <span class="norma__nombre">{{ f.nombre }}</span> {{ estado(f.estado, f.subestado) }}</p>
  {% if f.descripcion %}
  <p class="norma__descripcion">{{ f.descripcion }}</p>
  {% endif %}
  <p class="norma__meta">
    {%- if f.alcance == "serie" and f.partes -%}
      {%- set vig = f.partes.citadas | selectattr("vigente") | list -%}
      {%- if f.partes.otras and vig | length <= 5 and vig -%}
        Partes citadas vigentes: {% for p in vig %}{{ enlace(p.ultima) }}{% if not loop.last %}, {% endif %}{% endfor %}
      {%- elif vig -%}
        {{ f.partes.vigentes }} de {{ f.partes.relevantes }} {{ "partes citadas" if f.partes.otras else "partes" }} vigentes
      {%- elif f.sustituida_por -%}
        Sustituida por {{ enlaces(f.sustituida_por[:3]) }}{% if f.sustituida_por | length > 3 %} y otras{% endif %}
      {%- else -%}
        Sin partes vigentes
      {%- endif -%}
    {%- elif f.vigentes -%}
      Edición vigente: {{ enlace(f.vigentes[-1]) }}{% if f.suplementos %}, con {{ enlaces(f.suplementos) }}{% endif %}
    {%- elif f.sustituida_por -%}
      Sustituida por {{ enlaces(f.sustituida_por[:3]) }}{% if f.sustituida_por | length > 3 %} y otras{% endif %}
    {%- else -%}
      No publicada
    {%- endif -%}
    {%- if f.en_desarrollo and f.alcance == "norma" %} · Nueva edición en preparación: {{ enlace(f.en_desarrollo[0]) }}, {{ f.en_desarrollo[0].fase }}{% endif -%}
    {%- if f.superada %} · <span class="superada">El temario cita la edición de {{ f.edicion_citada.anio }}</span>{% endif -%}
    {%- if f.une %} · Norma UNE: {{ f.une }}{% endif -%}
  </p>
</div>
{%- endmacro %}
