{% macro estado(e, sub=None) -%}
<span class="estado estado--{{ e.value }}">{{ e.etiqueta }}</span>{% if sub %} <span class="subestado">{{ sub.etiqueta }}</span>{% endif %}
{%- endmacro %}

{# En las páginas de estudio solo se destacan los estados que requieren atención. #}
{% macro aviso(e, sub=None) -%}
{% if e.value != "vigente" or sub %}{{ estado(e, sub) }}{% endif %}
{%- endmacro %}

{% macro enlace(x) -%}
<a href="{{ x.url }}" title="Ficha en iso.org">{{ x.referencia }}</a>
{%- endmacro %}

{% macro enlaces(lista) -%}
{% for x in lista %}{{ enlace(x) }}{% if not loop.last %}, {% endif %}{% endfor %}
{%- endmacro %}

{% macro une_enlace(e) -%}
{% if e.url %}<a href="{{ e.url }}" title="Resolución del BOE que la publica">{{ e.codigo }}</a>{% else %}{{ e.codigo }}{% endif %}
{%- endmacro %}

{% macro une_marca(estado, etiqueta) -%}
<span class="une une--{{ estado }}">{{ etiqueta }}</span>
{%- endmacro %}

{# Una UNE vigente con la edición ISO que adopta y cuándo se aprobó. #}
{% macro une_detalle(e) -%}
{{ une_enlace(e) }}{% if e.iso_adoptada %}, adopta la {{ e.iso_adoptada }}{% elif e.deducido %}, que por fechas adopta la edición ISO vigente{% endif %}{% if e.aprobada %} (aprobada en {{ e.aprobada.mes or e.aprobada.fecha[:7] }}){% endif %}{% if e.estado == "anterior" %} {{ une_marca("anterior", "edición ISO anterior") }}{% endif %}
{%- endmacro %}

{# Subpestañas de «Estándares internacionales». ``raiz`` es la ruta hasta la raíz del sitio. #}
{% macro subpestanas(activa, raiz="") -%}
<nav class="subpestanas" aria-label="Estándares internacionales"><a href="{{ raiz }}ambito/"{% if activa == "ambito" %} aria-current="page"{% endif %}>Por ámbito</a><a href="{{ raiz }}temario/"{% if activa == "tema" %} aria-current="page"{% endif %}>Por tema</a></nav>
{%- endmacro %}
